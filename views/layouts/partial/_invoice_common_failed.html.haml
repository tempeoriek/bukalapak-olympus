- key = payment_type
- if key == 'atm'
  - key = 'transfer'
- category_id = 266
- reason = "Pembayaran belum terkonfirmasi"
- url = "https://bukabantuan.bukalapak.com/form/#{category_id}?invoice_id=#{transaction.invoice_id}&body=#{reason}"

%table
  %tbody
    %tr
      %td
        %div.box-table{style: "padding: 24px"}
          %p.label Total
          %p.text--large.text--crimson{style: 'margin-bottom: 8px'}
            = money(total_amount)
          %span.btn-icon
            %img{src: "https://s1.bukalapak.com/images/mailer/icon/transaction_failed.png", height: "16px" }
            %span.text--small Gagal
        %div.box-table.text--left
          %p.label Metode Pembayaran
          %img{src: "https://s1.bukalapak.com/images/mailer/payment_logo/#{key}.png", alt: "#{key}", title: "#{key}", height: "40px" }
          %p.text--medium= payment_method
    %tr
      %td.text--left{style: 'padding-top: 16px'}
        Jika kamu sudah melakukan pembayaran, silakan kirim bukti pembayaran melalui
        %a.txt--crimson{href: url, target: '_blank'} BukaBantuan.
