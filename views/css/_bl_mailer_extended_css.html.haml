:css
  body {
    -webkit-text-size-adjust: none;
  }

  /* Prevent Webkit platforms from changing default text sizes. */

  /* Some resets and issue fixes */

  #outlook a {
    padding: 0;
  }

  body {
    width: 100% !important;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
    margin: 0;
    padding: 0;
  }

  .ReadMsgBody {
    width: 100%;
  }

  .ExternalClass {
    width: 100%;
  }
  .backgroundTable {
    margin: 0 auto;
    padding: 0;
    width: 100% !important;
  }

  table td {
    border-collapse: collapse;
    font-size: 14px;
    line-height: 24px;
  }

  .ExternalClass * {
    line-height: 115%;
  }

  /* End reset */

  /* Email CSS Reset */

  body {
    margin: 0;
    padding: 0;
  }

  img {
    border: 0 none;
    height: auto;
    line-height: 100%;
    outline: none;
    text-decoration: none;
  }

  a img {
    border: 0 none;
  }

  .inline_block {
    display: inline-block;
  }

  table,
  td {
    border-collapse: collapse;
    border-spacing: 0;
    padding: 0;
    margin: 0;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p,
  a,
  span,
  td {
    font-family: "Helvetica Neue", Arial, sans-serif;
    padding: 0;
    margin: 0;
  }

  /* Template Styles */

  a {
    color: #d8184a !important;
    text-decoration: none;
  }

  h2 {
    font-size: 22px;
  }

  h3 {
    font-size: 18px;
  }

  h4 {
    font-size: 14px;
  }

  table {
    width: 100%;
    background: transparent;
  }

  #table_root {
    width: 100%;
    font-family: "Helvetica Neue", Arial, sans-serif;
    color: #474a52 !important;
    font-size: 14px;
    line-height: 26px;
    text-align: center;
    background-color: #fafafa;
  }

  #table_body {
    background-image: url('https://s3.bukalapak.com/uploads/attachment/829621/rectangle_3.png');
    background-repeat: no-repeat;
    background-position: top center;
  }

  .text--center {
    text-align: center;
  }

  .text--left {
    text-align: left;
  }

  .text--right {
    text-align: right;
  }

  .text--bold {
    font-weight: bold;
  }

  .text--tiny {
    font-size: 10px;
  }

  .text--large {
    font-size: 20px;
    font-weight: bold;
  }

  .text--medium {
    font-size: 16px;
  }

  .text--small {
    font-size: 12px;
  }

  .text--crimson {
    color: #ea5164;
  }

  .text--obsidian {
    color: #80868f;
  }

  .text--uranium-dark {
    color: #389c73;
  }

  .text--block {
    background: #ea5164;
    color: #fff;
    padding: 2px;
    border-radius: 4px;
  }

  .container {
    width: 600px;
    max-width: 600px;
  }

  .container-siblings {
    min-width: 16px;
  }

  .logo {
    padding: 48px 0 39px 0;
  }

  #table_content_td {
    width: 540px;
    padding: 30px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 4px 0 rgba(153, 153, 153, 0.24);
  }

  #content_body_header .banner {
    padding-bottom: 24px;
  }

  #content_footer {
    padding: 18px;
    background: #fff;
    border-radius: 8px;
    max-width: 600px;
    box-shadow: 0 2px 4px 0 rgba(153, 153, 153, 0.24);
  }

  #content_footer table td {
    font-size: 12px;
  }

  .separator-td {
    padding-top: 24px;
    padding-bottom: 29px;
  }

  .separator {
    width: 100%;
    height: 4px;
    margin: 0 auto;
    background: #f27191;
    border-radius: 2px;
  }

  .notification {
    display: block;
    padding: 14px 17px;
    border-radius: 3px;
    font-size: 14px;
    text-align: left;
    line-height: 20px;
  }

  .notification--yellow {
    background: #fcf3e6;
    border-left: 2px solid #f4b65d;
    color: #88642f;
  }

  .notification--gray {
    background: #f9fafb;
    border-left: 2px solid #adb4bc;
    color: #52565f;
  }

  .btn {
    text-align: center;
    width: 170px;
    color: #d71149 !important;
    border: 1px solid;
    border-radius: 4px;
    display: inline-block;
    text-decoration: none;
    padding-top: 6px;
    padding-bottom: 6px;
    font-weight: bold;
    font-size: 16px;
    line-height: 24px;
    transition: all 0.4s ease-in-out;
  }

  .btn.btn--red {
    color: #ffffff !important;
    background-color: #ea5164 !important;
    border-radius: 6px;
  }

  .btn.btn--small {
    width: 143px;
  }

  .btn.btn--block {
    width: 100%;
  }

  .btn-block {
    font-weight: bold;
    background: #fafafa;
    padding: 8px;
    display: block;
    border-radius: 4px;
    color: #282e33 !important;
  }

  .btn-icon {
    border-radius: 10px;
    padding: 4px 8px 6px;
    background: #e8eaef;
    font-weight: bold;
  }

  .btn-icon img,
  .btn-icon span {
    vertical-align: middle;
  }

  .btn--crimson {
    background: #ee4b60;
    color: #fff !important;
  }

  .btn--uranium {
    background: #46c490;
    color: #fff !important;
  }

  .label {
    color: #80868f;
  }

  .sublabel {
    font-size: 12px;
    color: #80868f;
    line-height: 14px;
  }

  .btn--block {
    display: block;
    width: 100%;
  }

  .btn--red {
    background: #ea5164;
    color: #fff !important;
  }

  .letter-box {
    border: 1px solid #eeeeee;
    padding: 25px 18px;
    border-radius: 4px;
  }

  .letter-box img {
    display: block;
  }

  .letter-box__title {
    line-height: 20px;
  }

  .letter-box__content {
    text-align: left;
    padding-left: 18px;
  }

  .letter-box__content p {
    font-size: 12px;
    line-height: 20px;
    padding: 10px 0 12px 0;
  }

  .box-table {
    border: 1px solid #eeeeee;
    padding: 16px;
  }

  .box-table:first-child {
    border-radius: 0;
  }

  .box-table:first-child {
    border-radius: 4px 4px 0 0;
  }

  .box-table:last-child {
    border-radius: 0 0 4px 4px;
  }

  .box-table + .box-table {
    border-top: 0;
  }

  .box-table--large {
    padding: 24px;
  }

  .normal-list ul,
  .normal-list ol {
    margin-left: -22px;
  }

  .normal-list li {
    padding-left: 8px;
  }

  .social-icons a {
    display: inline-block;
    text-decoration: none;
    padding: 0 6px;
  }

  .social-icons a img,
  .cs img {
    display: block !important;
  }

  .cs {
    padding: 12px 24px;
    border: 1px solid #eeeeee;
    border-radius: 4px;
    font-size: 12px;
    text-align: left;
  }

  .cs td {
    vertical-align: middle;
  }

  .cs img {
    padding-right: 18px;
  }

  .about-location {
    padding-top: 18px;
    text-align: left;
    font-size: 10px !important;
    line-height: 17px;
    color: #999 !important;
  }

  .about-link {
    padding-top: 12px;
  }

  .about .social-icons a {
    padding: 0 0 0 2px;
  }

  .copyright span {
    display: block;
    font-size: 10px;
    padding-top: 18px;
    line-height: 17px;
    color: #999999 !important;
    text-align: center;
  }

  .mobile{
    display: none;
  }

  #transaction-list {
    line-height: 20px;
    padding-bottom: 0;
  }

  .product {
    margin-bottom: 16px;
  }

  .product td {
    vertical-align: top;
  }

  .product__info {
    padding-right: 154px;
    position: relative;
  }

  .product__name {
    text-align: left;
    line-height: 20px;
  }

  .product__price {
    width: 154px;
    text-align: right;
    position: absolute;
    right: 0;
    top: 0;
  }

  .product__img {
    border: 1px solid #e2e2e2;
    border-radius: 2px;
    width: 60px;
    height: 60px;
    overflow: hidden;
    background: #dfe3e9;
  }

  .product__variant {
    list-style-type: disc;
    font-size: 12px;
    color: #80868f;
    margin: 4px 0 0;
    padding: 0;
  }

  .product__variant li {
    float: left;
    margin-left: 24px;
  }

  .product__variant li:first-child {
    margin-left: 14px;
  }

  .bundle-list {
    border-left: 1px solid #dfe3e9;
  }

  .bundle-list td {
    padding: 8px 0 16px;
  }

  .bundle-list__last td {
    padding-bottom: 0;
  }

  .bundle__img {
    border: 1px solid #e2e2e2;
    border-radius: 2px;
    width: 50px;
    height: 50px;
  }

  .key-value td {
    vertical-align: top;
  }

  .key-value td:last-child {
    width: 154px;
    text-align: right;
  }

  /* overwrite layout style */
  .container {
    box-shadow: 0 2px 4px rgba(153, 153, 153, 0.24) !important;
  }

  @media screen and (max-width: 768px) {
    #table_body{
      background-size: 180% !important;
      background-position: top center !important;
    }
    .logo {
      padding: 44px 0 24px 0 !important;
    }
    .container {
      padding: 12px !important;
      text-align: center !important;
    }
    .container>* {
      font-size: 14px !important;
      line-height: 24px !important;
    }
    #content_body_header h2 {
      font-size: 14px !important;
      line-height: 26px !important;
    }
    #content_body_header p {
      line-height: 24px !important;
      padding-top: 13px !important;
    }
    #table_body>tbody>tr>td {
      padding-bottom: 40px !important;
    }
    .separator-td {
      padding: 12px 0 24px 0 !important;
    }
    .content-body-header-second h4 {
      padding-bottom: 12px !important;
    }
    .content-body-header-second p {
      padding-bottom: 12px !important;
    }
    #content_body_header .banner {
      padding-bottom: 16px !important;
    }
    #content_body_header .banner img {
      width: 100% !important;
    }
    .table--responsive {
      display: block !important;
    }
    .table--responsive>tbody {
      display: block !important;
    }
    .table--responsive>tbody>tr {
      display: block !important;
    }
    .table--responsive>tbody>tr>td {
      display: block !important;
      width: 100% !important;
    }
    .pelapak-pembeli {
      text-align: center !important;
    }
    .pelapak-pembeli td {
      padding-bottom: 24px !important;
    }
    .letter-box {
      padding: 16px !important;
    }
    .letter-box img {
      display: inline-block !important;
    }
    .letter-box * {
      text-align: center !important;
    }
    .letter-box__content {
      padding-left: 0px !important;
    }
    .letter-box__content p {
      padding-top: 8px !important;
    }
    .letter-box__content a.btn.btn--small {
      font-size: 14px !important;
    }
    .box-table {
      padding: 12px !important;
    }
    .ikuti-kami * {
      text-align: center !important;
      line-height: 20px !important;
      font-size: 14px !important;
    }
    .ikuti-kami p {
      padding-bottom: 16px !important;
    }
    .ikuti-kami .clear-padding {
      padding-top: 24px !important;
    }
    .social-icons a {
      padding: 0 4px !important;
    }
    .cs * {
      font-size: 12px !important;
      line-height: 20px !important;
    }
    .cs img {
      padding-right: 12px !important;
    }
    .desktop {
      display: none;
    }
    .mobile {
      display: block !important;
    }
    .about * {
      text-align: center !important;
    }
    .about-app {
      padding-top: 6px;
    }
    .about .social-icons td {
      padding-top: 6px !important;
    }
    .copyright {
      text-align: center !important;
    }
    .padding-clear {
      padding-top: 24px !important;
    }
    .copyright span {
      padding-top: 12px !important;
    }
    .product__info {
      padding-right: 0 !important;
      position: relative;
    }

    .product__price {
      position: relative !important;
      text-align: left !important;
    }

    .key-value td:last-child {
      width: 50% !important;
    }
  }
