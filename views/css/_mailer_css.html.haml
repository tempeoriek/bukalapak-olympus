:css
  /* Client-specific Styles */
  #outlook a{padding:0;} /* Force Outlook to provide a "view in browser" button. */
  body{width:100% !important;} .ReadMsgBody{width:100%;} .ExternalClass{width:100%;} /* Force Hotmail to display emails at full width */
  body{-webkit-text-size-adjust:none;} /* Prevent Webkit platforms from changing default text sizes. */

  /* Email CSS Reset */
  body{margin: 0; padding: 0;}
  img{border: 0 none; height: auto; line-height: 100%; outline: none; text-decoration: none;}

  a img{border: 0 none;}

  table, td{border-collapse: collapse; border-spacing: 0; padding: 0; margin: 0;}

  h1, h2, h3, h4, h5, h6, p , a, span, td{font-family: "Arial", sans-serif; padding: 0; margin: 0;}

  /* General Styles */

  h1, h2, h3, h4, h5, h6, p , a, span, td {
    color: #333;
    line-height: 1.36;
  }

  a {
    color: #d71149!important;
    text-decoration: none;
  }

  h1 {
    font-size: 20px;
    font-weight: normal;
  }

  h2 {
    font-size: 16px;
  }

  small {
    font-size: 12px;
  }

  /* LAYOUT Styles */

  body {
    background-color: #f8f8f8;
  }

  #simplifyEmailOuterTable {
    border-collapse: collapse;
    margin: 0;
    padding: 0;
  }

  .u-txt--bold {
    font-weight: bold;
  }

  .simplifyEmailCenterWrapper {
    display: block;
    text-align: center;
  }

  .templateContainer {
    margin: 0 auto;
  }

  #contentContainer p,
  #contentContainer a,
  #contentContainer span,
  #contentContainer strong,
  #contentContainer ul,
  #contentContainer ol {
    color: #333;
    font-size: 14px;
  }

  #contentContainer .larger {
    font-size: 20px;
  }


  #contentContainer .large {
    font-size: 18px;
  }

  #contentContainer .medium {
    font-size: 16px;
  }

  #contentContainer .small {
    font-size: 12px;
  }

  #contentContainer .mt6 {
    margin-top: 6px;
  }

  #contentContainer a.highlight {
    font-weight: bold;
  }

  #contentContainer ol.normal-list,
  #contentContainer ol.tight-list {
    padding-left: 14px;
    margin: 0;
    font-size: 16px;
  }

  #contentContainer ol.normal-list > li {
    margin-top: 18px;
  }

  #contentContainer ol.tight-list > li {
    margin-top: 6px;
  }

  #flight-payment-detail > div {
    margin: 0 2px;
  }

  #flight-payment-detail > div + div {
    margin-top: 24px;
  }

  #highlight-code {
    font-weight: bold;
    font-size: 20px !important;
    border: solid 1px #d8184a;
    padding: 6px;
  }

  .flight-detail {
    border-top: solid 2px #ddd;
    border-bottom: solid 2px #ddd;
  }

  .flight-detail > tr > td {
    padding-top: 18px;
    padding-bottom: 18px;
    vertical-align: top;
  }

  .flight-detail > tr > td:first-child {
    border-right: solid 2px #ddd;
  }

  .flight-detail-description + .flight-detail-description {
    margin-top: 24px;
  }

  .flight-passengers {
    display: block;
    margin-bottom: 36px;
    padding: 18px 0;
    border-bottom: solid 2px #eee;
  }

  .flight-passengers > tr + tr > td {
    padding-top: 6px;
  }

  .passengers-list {
    padding-left: 30px;
    padding-right: 30px;
  }

  #contentContainer .passengers-list p {
    font-size: 16px;
  }

  #contentContainer .passengers-list > p + p {
    margin-top: 6px;
  }

  p.gray-text {
    color: #999 !important; /* ... */
  }

  .gray-text {
    color: #999 !important; /* ... */
  }

  .box {
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: solid 2px #eee;
  }

  .box.box--darker {
    border-bottom-color: #ddd;
  }

  #flight-invoice > table + table {
    margin-top: 18px;
  }

  .flight-price-description tr + tr > td {
    padding-top: 6px;
  }

  .flight-price-description td {
    vertical-align: bottom;
  }

  #atm-instruction .list-bank td {
    padding-bottom: 18px;
  }

  #atm-instruction .list-bank:last-child td {
    padding-bottom: 0;
  }

  #atm-instruction .list-bank td:first-child + td {
    padding-left: 48px;
  }

  #atm-instruction .list-bank p + p {
    margin-top: 6px;
  }

  /* FOR money */
  #contentContainer .currency,
  #contentContainer .amount {
    font-size: 14px;
  }

  #contentContainer .larger .currency,
  #contentContainer .larger .amount {
    font-size: 20px;
  }

  .detail-list tr > td > p {
    margin-top: 6px;
    margin-bottom: 6px;
  }

  #actionButton {
    background-color: #d71149;
    color: #ffffff !important;
    border-color: #d71149;
    text-decoration: none;
    display: block;
    padding: 7px 24px;
    font-weight: 700;
    text-align: center;
    font-size: 14px;
    margin-top: 30px;
  }

  #notes {
    background-color: #fafafa;
    padding: 12px;
  }

  #detailTable {
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: solid 2px #eee;
  }

  #detailTable th {
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: solid 2px #ddd;
    text-align: left;
  }

  #detailTable td {
    padding-bottom: 14px;
    font-size: 14px;
    vertical-align: top;
  }

  #detailTable > tr:nth-child(2) > td {
    padding-top: 14px;
  }

  #detailTable > .total-row {
    border-top: 2px solid #ddd;
  }

  #detailTable > .total-row > td {
    padding-top: 14px;
    padding-bottom: 0;
  }

  .tableReport {
    border-collapse: collapse;
    margin: 0;
    padding: 0;
  }

  .tableReport th {
    text-align: left;
    vertical-align: middle;
    font-weight: normal;
    color: #999;
    border: 1px solid #ddd;
    padding: 12px;
    white-space: nowrap;
  }
  .tableReport td {
    text-align: left;
    vertical-align: middle;
    font-weight: normal;
    color: #333;
    border: 1px solid #ddd;
    padding: 12px;
    white-space: nowrap;
  }
