%table#content_body_header.text--center
  %tbody
    %tr
      %td
        %div
          %img{src:"https://s1.bukalapak.com/images/mailer/invoice/success.png", :width => '450'}
%table#content_body_header.text--center
  %tbody
    %tr
      %td
        %div{style: "max-width: 500px; display: inline-block;"}
          %h3 Transaksi Kamu Berhasil Diproses
%table
  %tbody
    %tr
      %td
      %td.separator-td{style: "width: 77px;"}
        %div.separator
      %td
%table.text--left
  %tbody
    %tr
      %td.content-body-header-second
        %h4{style: "padding-bottom: 14px;"}
          = "Hai #{user[:name]},"
        %div{style: "max-width: 500px; display: inline-block;"}
          %p{style: "padding-bottom: 22px"}= I18n.t("mailer.succeed", product_name: "Listrik Pascabayar").html_safe
= render 'views/layouts/partial/_invoice_common_paid'
= render 'views/layouts/partial/_transaction_list.css'
- content_for :extra_content do
  %table#table_content
    %tr
      %td.container-siblings
      %td#table_content_td.container
        %table
          %tbody
            %tr
              %td.text--left
                %h1{style: "padding-bottom: 14px;"} Detail Transaksi
                %div.box-table.box-table--large
                  %p.label Nama Produk:
                  %p.text--medium Listrik Pascabayar PLN
                %div.box-table.box-table--large
                  %p.label Periode:
                  %p.text--medium= build_period(transaction.period)
                %div.box-table.box-table--large
                  %p.label Nama:
                  %p.text--medium= transaction.customer_name
                %div.box-table.box-table--large
                  %p.label ID. Pelanggan:
                  %p.text--medium= transaction.customer_number
                %div.box-table.box-table--large
                  %p.label Tarif/Daya:
                  %p.text--medium #{transaction.segmentation}/#{transaction.power} VA
                %div.box-table.box-table--large
                  %p.label Partner Layanan:
                  %p.text--medium #{transaction.partner_hash[:name]}
                %div.box-table.box-table--large
                  %table.key-value
                    %tr
                      %td
                        %p.label Jumlah Tertagih:
                      %td
                        %p.text--medium= money(transaction.amount - transaction.admin_charge - transaction.penalty_fee)
                    - if uniq_code.to_i > 0
                      %tr
                        %td Kode Pembayaran:
                        %td= money(uniq_code)
                    - if voucher_amount > 0
                      %tr
                        %td Voucher:
                        %td= "(-) #{money(voucher_amount)}"
                    - if deposit_reduction_amount > 0
                      %tr
                        %td Saldo Bukadompet:
                        %td= "(-) #{money(deposit_reduction_amount)}"
                    - if dana_reduction_amount > 0
                      %tr
                        %td Saldo DANA:
                        %td= "(-) #{money(dana_reduction_amount)}"
                    %tr
                      %td Biaya Administrasi:
                      %td= money(transaction.admin_charge)
                    - if transaction.penalty_fee > 0
                      %tr
                        %td Denda:
                        %td= money(transaction.penalty_fee)
                %div.box-table{style: 'padding-right: 24px'}
                  %table.key-value
                    %tr
                      %td
                        %strong Total
                      %td
                        %strong= money(total_amount)
        %table{style: 'margin-top: 16px'}
          %tr
            %td
              %a.btn-block{href: "https://www.bukalapak.com/payment/invoices/#{payment_id}", target: "_blank"}
                Lihat Detail Transaksi Listrik Pascabayar
        %td.container-siblings
